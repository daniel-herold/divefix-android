<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLowest">

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="88dp" android:visibility="gone" />
    <TextView android:id="@+id/noMatch" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
        android:padding="32dp" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="32dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_photos"
            android:importantForAccessibility="no" app:tint="?attr/colorOnSurfaceVariant" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="No photos or videos selected" android:textAppearance="?attr/textAppearanceTitleMedium" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:gravity="center" android:maxWidth="320dp" android:textColor="?attr/colorOnSurfaceVariant"
            android:text="Add them here, share them to DiveFix from your gallery, or connect your camera by USB and pick them from its card."
            android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/emptyAdd" style="@style/Widget.Material3.Button.Icon" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Add photos and videos" app:icon="@drawable/ic_add" />
    </LinearLayout>

    <FrameLayout android:id="@+id/single" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/black" android:visibility="gone">
        <SurfaceView android:id="@+id/surface" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_gravity="center" android:visibility="gone" />
        <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:contentDescription="Preview. Tap for full screen." />
        <com.divefix.app.LineOverlay android:id="@+id/lineOverlay" android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.divefix.app.CropOverlay android:id="@+id/cropOverlay" android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:id="@+id/drawBar" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/pill"
            android:gravity="center_vertical" android:paddingHorizontal="14dp" android:visibility="gone">
            <TextView android:id="@+id/drawHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingVertical="8dp" android:textColor="@android:color/white" android:textAppearance="?attr/textAppearanceLabelLarge" />
        </LinearLayout>
        <com.divefix.app.Histo android:id="@+id/histo" android:layout_width="@dimen/histo_w" android:layout_height="@dimen/histo_h"
            android:layout_gravity="top|start" android:layout_margin="10dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/prev" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:layout_marginStart="4dp"
            android:alpha="0.85" android:contentDescription="Previous" app:icon="@drawable/ic_chevron_left" />
        <com.google.android.material.button.MaterialButton android:id="@+id/next" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp"
            android:alpha="0.85" android:contentDescription="Next" app:icon="@drawable/ic_chevron_right" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" android:orientation="vertical" android:paddingHorizontal="8dp"
            android:paddingTop="32dp" android:paddingBottom="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom">
                <LinearLayout android:id="@+id/frameTools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone">
                    <com.google.android.material.button.MaterialButton android:id="@+id/frameBack" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="One frame back" app:icon="@drawable/ic_frame_prev" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/frameFwd" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="One frame forward" app:icon="@drawable/ic_frame_next" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/saveFrame" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Save this frame as a photo" app:icon="@drawable/ic_camera" />
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <LinearLayout android:id="@+id/geoGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:visibility="gone">
                    <com.google.android.material.button.MaterialButton android:id="@+id/geoRotate" style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Turn 90 degrees clockwise" app:icon="@drawable/ic_rotate" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/geoSave" style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Done" app:icon="@drawable/ic_check" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/geoDiscard" style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="2dp" android:contentDescription="Undo crop, trim and rotation" app:icon="@drawable/ic_close" />
                </LinearLayout>
                <LinearLayout android:id="@+id/gradientGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/gradLinear" style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:contentDescription="Linear gradient" app:icon="@drawable/ic_gradient" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/gradIn" style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:contentDescription="Circle gradient, full effect in the centre" app:icon="@drawable/ic_grad_in" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/gradOut" style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:contentDescription="Circle gradient, full effect outside" app:icon="@drawable/ic_grad_out" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/gradientSave" style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
                        android:contentDescription="Done drawing, keep the gradient" app:icon="@drawable/ic_check" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/gradientDiscard" style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="2dp" android:visibility="gone"
                        android:contentDescription="Remove the gradient" app:icon="@drawable/ic_close" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/compare" style="@style/Widget.Material3.Button.TonalButton.Icon" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Hold to compare" app:icon="@drawable/ic_compare" />
                <com.google.android.material.button.MaterialButton android:id="@+id/compareIcon" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
                    android:contentDescription="Hold to compare" app:icon="@drawable/ic_compare" />
            </LinearLayout>
            <LinearLayout android:id="@+id/angleRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:paddingStart="12dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Angle"
                    android:textColor="@android:color/white" android:textAppearance="?attr/textAppearanceLabelLarge" />
                <com.google.android.material.slider.Slider android:id="@+id/angleSlider" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="-45" android:valueTo="45" android:value="0"
                    android:stepSize="0.1" android:contentDescription="Straighten" app:labelBehavior="gone" app:tickVisible="false" />
                <TextView android:id="@+id/angleText" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end"
                    android:layout_marginEnd="8dp" android:fontFeatureSettings="tnum" android:textColor="@android:color/white"
                    android:textAppearance="?attr/textAppearanceBodySmall" android:contentDescription="Tap to reset the angle" />
            </LinearLayout>
            <LinearLayout android:id="@+id/trimRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:paddingStart="8dp" android:visibility="gone">
                <com.google.android.material.slider.RangeSlider android:id="@+id/trimSlider" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="0" android:valueTo="1"
                    android:contentDescription="Trim start and end" app:labelBehavior="gone" app:values="@array/trim_default" />
                <TextView android:id="@+id/trimTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" android:fontFeatureSettings="tnum" android:textColor="@android:color/white"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
            <LinearLayout android:id="@+id/videoRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/play" style="@style/Widget.Material3.Button.IconButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:contentDescription="Play" app:icon="@drawable/ic_play"
                    app:iconTint="@android:color/white" />
                <com.google.android.material.slider.Slider android:id="@+id/timeline" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="0" android:valueTo="1"
                    android:contentDescription="Position in video" app:labelBehavior="gone" />
                <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" android:fontFeatureSettings="tnum" android:textColor="@android:color/white"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/originalTag" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/pill"
        android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="Original" android:textColor="@android:color/white"
        android:textAppearance="?attr/textAppearanceLabelLarge" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/gridCompare" style="@style/Widget.Material3.Button.TonalButton.Icon"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp" android:layout_marginBottom="22dp" android:elevation="6dp" android:stateListAnimator="@null"
        android:text="Hold to compare" android:visibility="gone" app:icon="@drawable/ic_compare" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/addMore" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="16dp"
        android:contentDescription="Add more photos and videos" android:visibility="gone" app:srcCompat="@drawable/ic_add" />
</FrameLayout>
